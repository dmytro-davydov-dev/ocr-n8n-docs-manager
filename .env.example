APP_ENV=development
LOG_LEVEL=INFO
INTERNAL_API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=contracts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/contracts
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DOCUMENTS_STORAGE_PATH=/documents
MAX_UPLOAD_SIZE_BYTES=52428800
# n8n webhook that receives {"document_id": "..."} after a successful upload
# (FR-105). Until WS-04 ships this workflow, uploads persist but are marked
# "failed" with an explanatory error_message rather than silently hanging.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/document-uploaded
N8N_WEBHOOK_TIMEOUT_SECONDS=5
# Max times the n8n watchdog (02-processing-watchdog) will auto-retry a
# failed document via /auto-retry before it must stop and surface it for a
# human instead (Progress.md Blockers #4).
DOCUMENT_AUTO_RETRY_MAX=3
VITE_API_BASE_URL=http://localhost:8000/api
# Dev-only: mocks the backend's document/review endpoints so the frontend
# can be built/demoed without a running backend. The real endpoints
# (documents, OCR, extraction, review, chunks) have existed since WS-02/03
# and are the default now; set to true only for a frontend-only demo.
VITE_ENABLE_API_MOCKS=false
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
# WS-05 Done Criteria: n8n gets its own Postgres role, distinct from
# POSTGRES_USER/PASSWORD above, so app and n8n persistence are isolated by
# credentials, not just by database name. Created by infra/postgres-init.sh.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n-change-me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=replace-this-key

# WS-03: OCR engine (ADR-010). "paddleocr" is the real self-hosted engine;
# "tesseract" is the ADR-010 addendum engine, recommended for CPU-only
# deployments after paddleocr/paddlepaddle turned out to have a confirmed,
# upstream, unfixed native memory leak on CPU inference; "null" is a no-op
# stand-in for environments without either engine's dependencies installed.
OCR_ENGINE=paddleocr
OCR_RASTERIZE_DPI=200
OCR_MAX_RETRIES=3
# Only used when OCR_ENGINE=tesseract. 3-letter ISO 639-2 code (tesseract's
# own convention, distinct from PaddleOCR's 2-letter codes) -- set to match
# your real documents' language and make sure the matching
# tesseract-ocr-<lang> apt package is installed (see Dockerfile).
OCR_TESSERACT_LANG=eng

# WS-03: LLM provider (ADR-012). Any OpenAI-compatible endpoint works here
# (OpenAI itself, Azure OpenAI, a local Ollama/vLLM server) -- swap
# providers by changing these values, not code. Unset LLM_BASE_URL means
# extraction tasks fail fast with a clear "provider unavailable" outcome
# rather than silently no-op.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# WS-03: embedding provider (ADR-017), same OpenAI-compatible pattern as the
# LLM provider above.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# WS-03: chunking (ADR-018). Token count is approximated by whitespace
# splitting.
CHUNK_TOKEN_LIMIT=500
CHUNK_OVERLAP_TOKENS=50

# Phase 5: hybrid search ranking (ADR-019) and RAG chat context size (ADR-020).
SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_VECTOR_WEIGHT=0.6
SEARCH_DEFAULT_LIMIT=10
CHAT_CONTEXT_CHUNKS=5

# WS-05 Phase 2: celery-worker CPU/memory limits (docker-compose deploy.resources).
# PaddleOCR + embedding generation are CPU/memory-heavy; these keep a runaway
# job from starving the rest of the stack on a dev machine. Raise on a
# beefier host if OCR throughput is the bottleneck.
WORKER_CPU_LIMIT=2
WORKER_MEMORY_LIMIT=4G
WORKER_CPU_RESERVATION=0.5
WORKER_MEMORY_RESERVATION=1G
# ADR-008/WS-03's "controlled concurrency" for the OCR worker, actually wired
# up (celery's prefork pool otherwise defaults to the host's CPU count, not
# WORKER_CPU_LIMIT above -- see docker-compose.yml's celery-worker command).
# Keep in step with WORKER_CPU_LIMIT/WORKER_MEMORY_LIMIT: this is "how many
# OCR-capable workers", those are "how much room they collectively have".
WORKER_CONCURRENCY=2
