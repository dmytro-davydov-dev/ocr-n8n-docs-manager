APP_ENV=development
LOG_LEVEL=INFO
INTERNAL_API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=contracts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/contracts
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DOCUMENTS_STORAGE_PATH=/documents
MAX_UPLOAD_SIZE_BYTES=52428800
# n8n webhook that receives {"document_id": "..."} after a successful upload
# (FR-105). Until WS-04 ships this workflow, uploads persist but are marked
# "failed" with an explanatory error_message rather than silently hanging.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/document-uploaded
N8N_WEBHOOK_TIMEOUT_SECONDS=5
VITE_API_BASE_URL=http://localhost:8000/api
# Dev-only: mocks WS-02's /documents endpoints (Phase 1) until they ship.
# Set to false once the backend implements document ingestion.
VITE_ENABLE_API_MOCKS=true
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_NAME=n8n
N8N_DB_USER=postgres
N8N_DB_PASSWORD=postgres
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=replace-this-key

# WS-03: OCR engine (ADR-010). "paddleocr" is the real self-hosted engine;
# "null" is a no-op stand-in for environments without the native
# paddleocr/paddlepaddle dependencies installed.
OCR_ENGINE=paddleocr
OCR_RASTERIZE_DPI=200
OCR_MAX_RETRIES=3

# WS-03: LLM provider (ADR-012). Any OpenAI-compatible endpoint works here
# (OpenAI itself, Azure OpenAI, a local Ollama/vLLM server) -- swap
# providers by changing these values, not code. Unset LLM_BASE_URL means
# extraction tasks fail fast with a clear "provider unavailable" outcome
# rather than silently no-op.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# WS-03: embedding provider (ADR-017), same OpenAI-compatible pattern as the
# LLM provider above.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# WS-03: chunking (ADR-018). Token count is approximated by whitespace
# splitting.
CHUNK_TOKEN_LIMIT=500
CHUNK_OVERLAP_TOKENS=50
